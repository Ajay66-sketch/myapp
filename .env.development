# .env.development
# Local development environment configuration template

# Server port configuration
PORT=5000
API_PORT=5000

# Database connections (leave empty to fallback to in-memory mode)
MONGO_URI=mongodb://localhost:27017/messaging-app
# Pool size limit (default is 50)
MONGO_POOL_SIZE=10

# Caching & Distributed socket sync (leave empty to fallback to in-memory mode)
REDIS_URL=redis://localhost:6379

# Cryptographic token signing secret (keep it simple for development)
JWT_SECRET=dev_super_secret_key_antigravity_12345

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:3000
SOCKET_CLIENT_URL=http://localhost:3000

# Security Settings for dev mode
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DISABLE_CSRF=true
TRUST_PROXIES=loopback
