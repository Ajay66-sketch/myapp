# .env.staging
# Staging environment configuration template for testing and pre-release verification

# Server Port
PORT=5000
API_PORT=5000

# Mongoose Database Config (uses staging DB)
MONGO_URI=mongodb://db:27017/messaging-app-staging
MONGO_POOL_SIZE=30

# Redis Cache broker URL
REDIS_URL=redis://redis:6379

# Cryptographic token signing secret (Change this in real staging environment!)
JWT_SECRET=staging_super_secret_key_antigravity_54321

# CORS Allowed client domains (comma-separated if multiple, e.g. http://staging.myapp.com,http://admin.staging.myapp.com)
CORS_ALLOWED_ORIGINS=http://localhost,http://staging.myapp.com
CLIENT_URL=http://staging.myapp.com

# Staging Security configurations
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
DISABLE_CSRF=false
TRUST_PROXIES=1
