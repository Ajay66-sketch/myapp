# .env.production
# Production environment configuration template

# Server port configuration
PORT=5000
API_PORT=5000

# High-performance MongoDB cluster URI
MONGO_URI=mongodb://db:27017/messaging-app-production
MONGO_POOL_SIZE=50

# High-performance Redis cluster URL
REDIS_URL=redis://redis:6379

# Cryptographic token signing secret
# IMPORTANT: Generate a secure 256-bit key in your production environment!
# Example command to generate: openssl rand -base64 32
JWT_SECRET=production_change_me_to_something_extremely_random_and_secure_9999

# Allowed CORS client domains (comma-separated if multiple, e.g. https://myapp.com,https://app.myapp.com)
CORS_ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
CLIENT_URL=https://myapp.com

# Production-safe security defaults
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
DISABLE_CSRF=false
TRUST_PROXIES=1
